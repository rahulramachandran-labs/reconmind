# Copy to .env and fill in what you need. Nothing here is required for a local demo.

APP_ENV=local
LOG_LEVEL=INFO

# Postgres (docker compose up -d postgres). Without it, chat sessions live in memory.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reconmind:reconmind@localhost:5432/reconmind

# Retrieval
RETRIEVER=hybrid
EMBEDDINGS_BACKEND=sentence-transformers
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE=faiss
PINECONE_API_KEY=
PINECONE_INDEX=reconmind

# LLM fallback chain, tried in order. DEMO_MODE=true skips the paid ones.
LLM_PROVIDERS=["openai","anthropic","ollama"]
DEMO_MODE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Retrieval reranking (cross-encoder over the fused top 10)
RERANKER=cross-encoder

# Agents
DOMAIN_ADAPTER=retail_recon
MCP_TRANSPORT=stdio
# set these to reach the MCP servers over HTTP instead (docker compose does)
WAREHOUSE_MCP_URL=
ORCHESTRATION_MCP_URL=
PLANNER_CONFIDENCE_THRESHOLD=0.5
REVIEW_CONFIDENCE_THRESHOLD=0.6

# Tracing (optional): LangFuse Cloud or the self-hosted one in docker compose
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Operations
SCAN_INTERVAL_MINUTES=0
RATE_LIMITS_ENABLED=true
# when set, scans and review decisions need it as a bearer token (the web app sends it)
WRITE_TOKEN=

# API
CORS_ORIGINS=["http://localhost:3000"]

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_SECRET=
AUTH_DEMO_MODE=true
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_ALLOWED_GITHUB_LOGINS=
RECONMIND_WRITE_TOKEN=
