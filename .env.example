# =============================================================================
#  ReconMind: environment settings for the API, the agents and the MCP servers
# =============================================================================
#
#  How to use this file
#  --------------------
#  `make bootstrap` copies it to `.env` the first time you run it. Edit `.env`,
#  never this file, and never commit `.env`: it is gitignored for a reason.
#
#  You don't need to fill in anything to try the project. With every value left
#  as it is below, you get:
#    - the seeded synthetic pipeline in a local Postgres (`make dev` starts it)
#    - hybrid search over the runbooks with a local embedding model
#    - the full agent graph, with answers written from templates and the
#      runbooks, because no model key is set (cost: $0)
#
#  Add an OpenAI or Anthropic key, or run Ollama, and the agents start writing
#  their own explanations. Everything else here is tuning.
#
#  Every variable maps to a field in app/core/config.py (same name, lower
#  case). Anything you leave out falls back to the default there.
#
#  The web app has its own settings: see frontend/.env.example.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. Basics
# -----------------------------------------------------------------------------

# A label for where this is running (local, staging, production). It only shows
# up in logs; nothing changes behaviour based on it.
APP_ENV=local

# DEBUG, INFO, WARNING or ERROR. Logs are JSON lines on stdout, one per event.
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
#  2. Database (Postgres)
# -----------------------------------------------------------------------------
#  Postgres holds the loaded transactions, agent runs and their traced steps,
#  incident reports, review decisions, chat history and the append-only audit
#  ledger. LangGraph also checkpoints paused runs here, which is what lets a
#  run wait for a reviewer and pick up again later, even after a restart.
#
#  Without a database the API still starts: runs and chat sessions are kept in
#  memory and are lost when it stops. Fine for a quick look, not for a demo.

# Host port for the Postgres container that `docker compose` / `make dev` starts.
# Already using 5432 for something else? Pick another port, say 5433, and change
# the port in DATABASE_URL below to match.
POSTGRES_PORT=5432

# Standard SQLAlchemy-style URL. postgresql:// and postgres:// both work.
DATABASE_URL=postgresql://reconmind:reconmind@localhost:5432/reconmind

# Container only (read by scripts/start.sh): load the seeded sample data on
# startup. Files that are already loaded are skipped, so it is safe on every
# restart. Render and docker compose set this to true.
# SEED_SAMPLE=false


# -----------------------------------------------------------------------------
#  3. Language models
# -----------------------------------------------------------------------------
#  Models only write explanations. Every number in an incident report comes
#  from a deterministic check, so a missing or failing model never changes what
#  was found; it only changes who writes the root-cause paragraph.
#
#  Providers are tried in the order below. One that fails (no key, timeout,
#  rate limit) is benched for LLM_COOLDOWN_S seconds and the next one is tried.
#  If none answer, you get an extractive answer: the most relevant sentences
#  from the runbooks, with citations, clearly labelled as such.

# The fallback order, as a JSON list. Remove a name to skip that provider.
LLM_PROVIDERS=["openai","anthropic","groq","gemini","openrouter","ollama"]

# true = never call a paid provider, whatever keys are set. Use this for demos
# and CI so a stray key can't run up a bill. Ollama and templates still work.
DEMO_MODE=false

# OpenAI. Leave the key empty to skip OpenAI entirely.
OPENAI_API_KEY=

# Any chat model your key can use. Cost is estimated per call from the price
# table in app/llm/providers.py and shown on the dashboard.
OPENAI_MODEL=gpt-5-mini

# Anthropic. Leave the key empty to skip it.
ANTHROPIC_API_KEY=

# Claude model id.
ANTHROPIC_MODEL=claude-haiku-4-5

# Free tiers. Each one takes a key from its own console and nothing else; all three
# speak the OpenAI chat API. Free tiers limit tokens per minute, so a failed call
# waits out a 429 and retries before the next provider is tried, and at most
# LLM_CONCURRENCY calls run at once. Their cost is recorded as $0.

# Groq (https://console.groq.com/keys). gpt-oss-120b is on the free plan
# (30 requests and 8K tokens a minute, 1K requests a day).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Which Groq model is asked for JSON (incident write-ups, plans, run summaries). The default
# is the same one that answers prose, because that is what measured best on this account:
# three of three replies valid, and faster with JSON mode on than off (ADR 0014). Point this
# at another model if your account has one that does better, and check `/model` to see which
# is in use.
GROQ_STRUCTURED_MODEL=openai/gpt-oss-120b

# Google Gemini (https://aistudio.google.com/apikey). Thinking is turned off
# (2.5 and later think by default) so the whole token budget goes to the answer.
# New keys can't use gemini-2.5-flash any more; 3.6 Flash works with a free AI Studio key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter (https://openrouter.ai/keys). Model ids ending in :free cost nothing;
# the free list changes, so check https://openrouter.ai/models?q=free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free

# Ollama runs models on your own machine for free (https://ollama.com).
# `ollama pull qwen2.5:1.5b` once, and it is picked up automatically.
# Set the URL to empty to turn Ollama off (the hosted demo does this).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Seconds to wait for one model call before trying the next provider. Small
# local models on a laptop can be slow, so this is generous.
# LLM_TIMEOUT_S=60

# Seconds a failed provider sits out before it is tried again, so one outage
# doesn't add a timeout to every request.
# LLM_COOLDOWN_S=60

# How many model calls may run at once. A scan writes up its findings in
# parallel; two at a time keeps a free tier under its tokens-per-minute limit.
# LLM_CONCURRENCY=2

# Output tokens allowed for a write-up or a run summary. An incident report is a
# root cause, fix steps, a confidence and open questions, and a reply cut off at
# the limit is wasted: it cannot validate. Raise this before blaming the model.
# LLM_MAX_OUTPUT_TOKENS_REPORT=2048


# -----------------------------------------------------------------------------
#  4. Knowledge retrieval (RAG)
# -----------------------------------------------------------------------------
#  The knowledge base is the markdown in corpus/ (runbooks, schema docs, past
#  incident write-ups) plus the dbt model YAML in dbt/models. It is chunked by
#  section and indexed twice: BM25 for exact identifiers, embeddings for
#  meaning. The two rankings are fused (reciprocal rank fusion), then a
#  cross-encoder re-scores the top candidates.
#
#  The index is rebuilt when the documents change: a fingerprint of the chunks
#  and the model name decides whether the cached vectors in .index/ still apply.

# hybrid (default, best), dense (embeddings only) or bm25 (keywords only).
# The other two are there so you can compare them; the Docs page does this too.
RETRIEVER=hybrid

# Where the embeddings come from:
#   sentence-transformers  local, PyTorch (default for development)
#   fastembed              the same MiniLM model on onnxruntime; much smaller,
#                          used in the Docker image
#   openai                 OpenAI embeddings; needs OPENAI_API_KEY
#   hashing                no model at all; only for fast tests
EMBEDDINGS_BACKEND=sentence-transformers
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Used only when EMBEDDINGS_BACKEND=openai.
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# Where the vectors live:
#   faiss     in memory, rebuilt on startup (default; nothing to set up)
#   pinecone  a managed index shared by every API instance; needs the key below
VECTOR_STORE=faiss

# Only for VECTOR_STORE=pinecone. The index is created if it doesn't exist.
PINECONE_API_KEY=

# Name of the Pinecone index to use or create.
PINECONE_INDEX=reconmind

# cross-encoder re-scores the fused top candidates, which lifts context
# precision from 0.76 to 0.83 on the golden set. Set it to none on small
# machines: with the reranker the container went past 512 MB and was killed,
# so the free hosted instance runs without it (docs/adr/0003).
RERANKER=cross-encoder

# The reranker model, and how many fused candidates it re-scores.
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES=10

# Where the documents and the index cache are. Defaults are inside the repo;
# a relative path here is taken from the directory the API starts in.
# Point CORPUS_DIR at your own runbooks to try ReconMind on your docs.
# CORPUS_DIR=corpus
# DBT_MODELS_DIR=dbt/models
# INDEX_DIR=.index


# -----------------------------------------------------------------------------
#  5. Agents
# -----------------------------------------------------------------------------

# Set to false to serve retrieval and /ask only, without the agent graph.
# AGENTS_ENABLED=true

# Which business domain the agents work on. Every domain rule (keys,
# thresholds, severity rubric, wording) lives behind this adapter.
#   retail_recon            the retail reconciliation domain (the project)
#   example_support_triage  a small second domain proving the agents are generic
DOMAIN_ADAPTER=retail_recon

# How the agents reach the two MCP tool servers (warehouse-metadata and
# orchestration-metadata):
#   stdio      each server runs as a subprocess of the API (default, local)
#   inprocess  servers run inside the API process; one small container, no
#              extra processes (what the hosted demo uses)
MCP_TRANSPORT=stdio

# Set these to reach the MCP servers over HTTP instead (streamable HTTP).
# docker compose's `full` profile runs them as their own services and sets these.
WAREHOUSE_MCP_URL=
ORCHESTRATION_MCP_URL=

# The MCP servers read these too. Only change them if you generate your own data
# somewhere else with scripts/generate_synthetic_pipeline.py.
# DBT_MANIFEST=dbt/target/manifest.json
# DAG_RUNS_PATH=data/sample/airflow/dag_runs.json

# When the Planner is less sure than this about which specialist should look,
# it pauses and asks a person to pick (0 to 1).
PLANNER_CONFIDENCE_THRESHOLD=0.5

# Incident reports whose root-cause confidence is below this wait in the review
# queue before they are published. S1 findings always wait, whatever this says.
REVIEW_CONFIDENCE_THRESHOLD=0.6


# -----------------------------------------------------------------------------
#  6. Tracing (LangFuse, optional)
# -----------------------------------------------------------------------------
#  Every agent step, tool call, retrieval and model call is always recorded in
#  Postgres and shown on the Traces page. Set these to mirror the same traces
#  to LangFuse: LangFuse Cloud, or the self-hosted one that
#  `docker compose --profile full up` starts on :3001.

LANGFUSE_PUBLIC_KEY=

# Keep this one secret, like any API key.
LANGFUSE_SECRET_KEY=

LANGFUSE_HOST=http://localhost:3001


# -----------------------------------------------------------------------------
#  7. Security and limits
# -----------------------------------------------------------------------------

# The shared secret for everything that changes state: starting a scan and
# recording review decisions. When it is set, those calls need the header
# `Authorization: Bearer <token>`. The web app adds it on the server side after
# checking the user's session, so the token never reaches a browser.
# Leave it empty for local development. Always set it on a public deployment:
#   openssl rand -hex 24
WRITE_TOKEN=

# Per-client request limits (by IP), so one visitor can't use up the model
# budget or keep the free instance busy. Format: <count>/<second|minute|hour|day>
RATE_LIMITS_ENABLED=true
# RATE_LIMIT_CHAT=20/minute
# RATE_LIMIT_SCAN=4/minute
# RATE_LIMIT_ASK=30/minute
# RATE_LIMIT_REGENERATE=10/minute

# Longest question accepted, and how many earlier question/answer pairs from
# the same chat session are sent along as context.
# MAX_QUESTION_CHARS=1000
# HISTORY_TURNS=3

# Which web origins may call the API from a browser (JSON list). Add your own
# domain when you deploy the frontend somewhere else.
CORS_ORIGINS=["http://localhost:3000"]


# -----------------------------------------------------------------------------
#  8. Scheduling
# -----------------------------------------------------------------------------

# Run a full scan every N minutes from inside the API process. 0 turns it off.
# Only useful on a server that never sleeps; the hosted demo sleeps when idle,
# so its scans come from .github/workflows/refresh-demo.yml instead.
SCAN_INTERVAL_MINUTES=0


# -----------------------------------------------------------------------------
#  9. Local ports for docker compose (optional)
# -----------------------------------------------------------------------------
#  Change any of these if something else on your machine already uses the port.

# API_PORT=8000
# WEB_PORT=3000
# OLLAMA_PORT=11434
# LANGFUSE_PORT=3001
