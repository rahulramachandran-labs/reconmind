# Copy to .env and fill in what you need. Nothing here is required for a local demo.

APP_ENV=local
LOG_LEVEL=INFO

# Postgres (docker compose up -d postgres). Without it, chat sessions live in memory.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reconmind:reconmind@localhost:5432/reconmind

# Retrieval
RETRIEVER=hybrid
EMBEDDINGS_BACKEND=sentence-transformers
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE=faiss
PINECONE_API_KEY=
PINECONE_INDEX=reconmind

# LLM fallback chain, tried in order. DEMO_MODE=true skips the paid ones.
LLM_PROVIDERS=["openai","anthropic","ollama"]
DEMO_MODE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# API
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
