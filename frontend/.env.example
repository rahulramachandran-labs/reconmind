# =============================================================================
#  ReconMind web app (Next.js): environment settings
# =============================================================================
#
#  Copy to frontend/.env.local for local development. `make bootstrap` creates
#  that file for you with a fresh AUTH_SECRET and the local API URL, which is
#  all you need to run `make dev`.
#
#  On Vercel, set the same names under Project Settings -> Environment Variables.
#
#  Rule of thumb: only NEXT_PUBLIC_* values are ever sent to the browser.
#  Everything else stays on the server.
# =============================================================================


# -----------------------------------------------------------------------------
#  Where the API is
# -----------------------------------------------------------------------------

# The ReconMind API as the browser sees it. Pages read the dashboard,
# incidents, traces and docs from here directly, and chat streams from it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The API as the Next.js server sees it, used for writes (scans and review
# decisions). Usually the same URL, so it is commented out: when it isn't set,
# the one above is used. Don't set it to an empty value.
# RECONMIND_API_URL=http://localhost:8000

# Must match WRITE_TOKEN in the API's .env. The server adds it to scans and
# review decisions after checking who is signed in, so the browser never sees
# it. Leave it empty when the API has no WRITE_TOKEN (local development).
RECONMIND_WRITE_TOKEN=


# -----------------------------------------------------------------------------
#  Sign-in (Auth.js)
# -----------------------------------------------------------------------------
#  Reading is open to everyone. Running a scan and approving or rejecting a
#  finding need a signed-in reviewer, and the reviewer's name is written to the
#  audit ledger with every decision.

# Signs the session cookie. Any long random string; generate one with
#   openssl rand -base64 32
# Changing it signs everyone out.
AUTH_SECRET=

# true (default): the sign-in page offers "Continue as the demo reviewer", so
# anyone can try the full flow without an account. Right for a public demo.
# false: only the sign-in methods below are offered.
AUTH_DEMO_MODE=true

# GitHub sign-in. Create an OAuth app at https://github.com/settings/developers
# with the callback URL  <your site>/api/auth/callback/github
# Both values must be set for the GitHub button to appear.
AUTH_GITHUB_ID=

AUTH_GITHUB_SECRET=

# Comma-separated GitHub usernames allowed to sign in. Leave it empty to
# allow any GitHub account.
AUTH_ALLOWED_GITHUB_LOGINS=
